# ── ReCon Pro environment ──
# Copy this file to `.env` and fill in your Supabase project values to run in
# LIVE mode (real authentication + live data).
#
# If these are left blank/unset, the app automatically starts in safe local
# DEMO PREVIEW MODE (realistic sample data, no live database). This is what
# GitHub Codespaces uses out of the box — no secrets required.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
